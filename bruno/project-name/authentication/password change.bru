meta {
  name: password change
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rest-auth/password/change/
  body: json
  auth: inherit
}

headers {
  Authorization: {{token}}
}

body:json {
  {
      "new_password1": "123456",
      "new_password2": "123456",
      "old_password": "your_new_password"
  }
}

settings {
  encodeUrl: true
}
